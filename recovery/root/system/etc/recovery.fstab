#<src>                                              <mnt_point>   <type>      <mnt_flags and options>    <fs_mgr_flags>
system                                               /system       erofs        ro    logical,first_stage_mount.display="system erofs"
system                                               /system       ext4        	ro    logical,first_stage_mount,display="system ext4"
vendor                                               /vendor       erofs        ro    logical,first_stage_mount
product                                              /product      erofs        ro    logical,first_stage_mount
odm                                                  /odm          erofs        ro    logical,first_stage_mount

/dev/block/platform/bootdevice/by-name/metadata    /metadata     ext4        defaults           wait,first_stage_mount
/dev/block/by-name/userdata      		   /data         f2fs        defaults                  wait,length=-16384
/dev/block/by-name/misc          		   /misc         emmc        defaults				wait,first_stage_mount

